select:
 - platform: modbus_controller
   modbus_controller_id: srne1
   name: "Piorytet wyjscia zmiana pozycji" #name for HA
   id: srne_output_priority2 #id for HA
   address: 0xE204
   value_type: U_WORD
   icon: mdi:power
   optionsmap:
      “SOL_O”: 0
      “UTI_1”: 1
      “SBU_2”: 2

 - platform: modbus_controller
   modbus_controller_id: srne1
   name: "Overcharge2" #name for HA
   id: srne_overcharge_voltage2 #id for HA
   address: 0xE008
   value_type: U_WORD
   icon: mdi:power
   optionsmap:
      “56.4”: 141
      “56.0”: 140
      “55.6”: 139      
#0: Priorytet PV – ładowanie z sieci uruchamiane tylko wtedy, gdy energia z PV jest niedostępna.
#1: Priorytet sieci – ładowanie z PV uruchamiane tylko wtedy, gdy zasilanie z sieci jest niedostępne.
#2: Tryb hybrydowy – jednoczesne ładowanie z sieci oraz z PV, z pierwszeństwem dla PV.
#3: Tylko PV – brak ładowania z sieci.#
   
 - platform: modbus_controller
   modbus_controller_id: srne1  
   name: "Charger Source Priority(SNU)"
   id: srne_charger_source_priority
   address: 0xE20F
   value_type: U_WORD
   icon: "mdi:battery-charging-setting"
   optimistic: false
   optionsmap: 
      "Solar First / PV Priority (CSO)": 0
      "Utility First / Mains Priority (CUB)": 1
      "Solar & Utility / Hybrid Charging (SNU)": 2
      "Only Solar / Only PV (OSO)": 3

 - platform: modbus_controller
   modbus_controller_id: srne1  
   name: "SRNE Ładowanie Czasowe (Harmonogram)"
   id: srne_sectional_charge_enable
   address: 0xE02C
   value_type: U_WORD
   icon: "mdi:calendar-clock"
   optimistic: false
   optionsmap:
      "Wyłączone (Disabled)": 0
      "Włączone (Enabled)": 1
      
 - platform: modbus_controller
