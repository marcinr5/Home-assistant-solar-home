  password: !secret wifi_password
  manual_ip:
    gateway: 192.168.100.1
    static_ip: 192.168.100.95
    subnet: 255.255.255.0
  


uart:
 id: mod_bus
 tx_pin: GPIO1
 rx_pin: GPIO3
 baud_rate: 9600
 stop_bits: 1 
modbus:
 id: tdt1_modbus
 flow_control_pin: 4
 
modbus_controller:
 - id: srne1
   address: 0x01
   modbus_id: tdt1_modbus
   setup_priority: -10
   update_interval: 15000ms #data refresh rate

sensor:
